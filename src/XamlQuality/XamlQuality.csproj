<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>Bennewitz.Ninja.XamlQuality</PackageId>
    <AssemblyProduct>XamlQuality</AssemblyProduct>
    <FamilyReadme>docs/xamlquality.md</FamilyReadme>
    <AssemblyName>XamlQuality</AssemblyName>
    <Description>
      Static analysis rules for XAML markup quality: accessibility names, theme-token
      discipline, resource keys a theme leaves undefined, contrast floors, and the
      conventions a XAML codebase drifts away from silently.

      A RULES library, not a test library. Each rule takes a scan context and returns
      findings; nothing here references a test framework, so the same rules drive MSTest,
      xUnit, a CLI or an MSBuild target without inheriting anyone else's runner.

      Dependency-free by design, and that includes Avalonia. Every rule reads markup as
      text or as XML, so the library is as useful against WPF or MAUI XAML as against
      Avalonia's — and a quality analyser that drags dependencies into a consumer's test
      project is one people stop referencing.
    </Description>
    <PackageTags>xaml;avalonia;wpf;maui;accessibility;theme;analysis;quality;lint</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- ⛔ Not yet trimmable, so it says so rather than shipping the claim src/Directory.Build.props
         makes for every library: it reads types and IL by reflection (ElementTypes, CompiledStrings),
         and the trim analyser reports 106 places (IL2026, IL2070, IL2075, IL2059, IL2065), measured
         2026-10-26. Exempted in .github/repository.json under props, by plans/00009 decision 19,
         until plans/00008 side 2 makes it trim-clean; then these two lines and the exemption go. -->
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <!-- The reviewed theme mappings ship beside the assembly, so a configuration can name one
         without a path ("mapping": "FluentToSemi") and override it with a path of its own.
         ⚠ They live with the LIBRARY rather than the tool, because the library is what reads
         them — a test project using the rules directly needs them just as much as the CLI does.
         PackagePath puts them in contentFiles so they travel to a consumer too. -->
    <!-- ⚠ Link, because the SOURCE path gained a ThemeAudit/ segment when the analysis moved in
         here but the RUNTIME path must not: the loader resolves a bare mapping name against
         "<output>/Mappings", so nesting them in the output turns `"mapping": "FluentToSemi"`
         into a file-not-found. Source layout and runtime layout are allowed to differ, and this
         is a case where they have to. -->
    <!-- ⛔ PackageCopyToOutput is what makes them travel; CopyToOutputDirectory does NOT.
         CopyToOutputDirectory governs THIS build, so the CLI gets them via its ProjectReference
         and the bare-name lookup works there. A PackageReference consumer got a contentFiles
         entry with no copyToOutput="true", so nothing landed beside their assembly and
         `"mapping": "FluentToSemi"` — the form this library's own docs advertise — could only
         ever be a file-not-found. Shipped that way in 2026.3.920. -->
    <None Include="ThemeAudit/Mappings/*.json"
          Link="Mappings/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackageCopyToOutput="true"
          PackagePath="contentFiles/any/any/Mappings/" />
  </ItemGroup>
</Project>

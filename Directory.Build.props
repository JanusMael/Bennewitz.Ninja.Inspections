<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Absolute repository root for targets that shell out to scripts/. -->
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <!-- Namespace convention: Bennewitz.Ninja.<AssemblyName>; assembly names stay unprefixed. -->
    <RootNamespace>Bennewitz.Ninja.$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Bennewitz.Ninja.AutoVersioning source generator: version stamps computed at build time. -->
    <GenerateAutoVersionedAssemblyInfo>true</GenerateAutoVersionedAssemblyInfo>
    <AssemblyCompany>Bennewitz.Ninja</AssemblyCompany>
    <!-- The repository's, for what ships nothing: tests, tools and the scripts. AutoVersioning
         fails any project without one (BNAV03). Each family's packages set their own:
         XamlQuality, AssemblyQuality or CodeQuality, in their csproj, which is read after this.
         PublicVersion is in Directory.Build.targets, where Version already has its default. -->
    <AssemblyProduct>Inspections</AssemblyProduct>
    <CopyrightHolder>Brian Bennewitz</CopyrightHolder>
    <CommitSha Condition="'$(CommitSha)' == ''">$(GITHUB_SHA)</CommitSha>
  </PropertyGroup>

  <!-- Package metadata shared by every packable project. Without a licence expression a package is
       one nobody's compliance review passes; without Authors it packs as the assembly name; without
       a repository URL the nuspec carries a commit hash pointing at nothing. PackageTags are
       per-project and live in the csproj beside the Description. -->
  <PropertyGroup>
    <Authors>Brian Bennewitz</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/JanusMael/Bennewitz.Ninja.Inspections</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JanusMael/Bennewitz.Ninja.Inspections</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- PDB policy: portable in Debug for local source stepping; embedded in Release so the
       shipped binary carries its own symbols and nothing loose has to travel with it. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bennewitz.Ninja.AutoVersioning"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <!-- Microsoft.VisualStudio.Threading.Analyzers, for two rules alone, the maintainer's decision of
       2026-11-03: VSTHRD101, an async lambda given where a void delegate is expected, which makes it
       async void, and VSTHRD110, a task nobody awaits. The first ends the process on a throw and the
       second loses the failure, as Inspections' docs/exception-resilience.md measured. The other
       rules are about Visual Studio's JoinableTaskFactory, or style, and are off: measured on
       DiffView, they found 49 sites and no defect. Private: nothing a package ships carries it. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);VSTHRD001;VSTHRD002;VSTHRD003;VSTHRD004;VSTHRD010;VSTHRD011;VSTHRD012;VSTHRD013</NoWarn>
    <NoWarn>$(NoWarn);VSTHRD100;VSTHRD102;VSTHRD103;VSTHRD104;VSTHRD105;VSTHRD106;VSTHRD107;VSTHRD108;VSTHRD109</NoWarn>
    <NoWarn>$(NoWarn);VSTHRD111;VSTHRD112;VSTHRD113;VSTHRD114;VSTHRD115;VSTHRD116;VSTHRD117</NoWarn>
    <NoWarn>$(NoWarn);VSTHRD200;VSTHRD201;VSTHRD202</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <!-- Bennewitz.Ninja.CodeQuality, every rule at its default, the maintainer's decision of
       2026-11-10: the source-side twin of the AssemblyQuality tests. Its rules report while the code
       is written what AssemblyQuality finds after the build, and the shapes Inspections'
       docs/exception-resilience.md measured to end the process or fail silently: a timer, thread or
       watcher callback outside a try/catch, a gate released outside a finally, an async lambda an Rx
       operator never awaits. Each rule is inert where what it reads is out of reach. A finding that
       cannot throw on real input is suppressed where it stands, with the reason. Private: nothing a
       package ships carries it.

       This repository is CodeQuality's source, so the published package is the one that gates the
       build, not the head being changed, and the two projects that hold the source never take it:
       one restore never holds a project and a package of the same id, as for AssemblyQuality in
       Directory.Packages.props. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'CodeQuality' and '$(MSBuildProjectName)' != 'CodeQuality.Tests'">
    <PackageReference Include="Bennewitz.Ninja.CodeQuality"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <!-- The README travels inside every package, so nuget.org shows the same text the repository
       does. Packable projects only: a test project with no README is not a packaging error.

       In a repository with package families, each family's packages carry the family's README
       instead: docs/<stem>.md, which each of its projects names in FamilyReadme, beside its
       family's AssemblyProduct. Packed as README.md, so nuget.org shows the family's page, not the
       repository's. Items are evaluated after every property, so the csproj's value is the one read
       here. `repo-conventions check` fails a family's package that names another file, or none. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true' and '$(FamilyReadme)' == ''">
    <None Include="$(RepoRoot)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true' and '$(FamilyReadme)' != ''">
    <None Include="$(RepoRoot)$(FamilyReadme)" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>
</Project>

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Contrast's own dictionary, which the theme reaches through an include; what Contrast does not
       define it inherits from Dark. -->
  <SolidColorBrush x:Key="OnlyContrast" Color="#FFFF00" />
</ResourceDictionary>

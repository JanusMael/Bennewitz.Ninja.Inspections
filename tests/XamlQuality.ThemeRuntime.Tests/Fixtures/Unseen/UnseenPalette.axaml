<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="XamlQuality.ThemeRuntime.Tests.UnseenPalette">
  <!-- A dictionary with a class of its own in a theme dictionary, as Semi holds its palettes: entry>ResourceInclude>theme-class.
       B7 finds K7 on its own chain. -->
  <Color x:Key="K7">#404040</Color>
  <SolidColorBrush x:Key="B7" Color="{StaticResource K7}" />
</ResourceDictionary>

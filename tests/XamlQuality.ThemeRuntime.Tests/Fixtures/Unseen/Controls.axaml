<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- An index a merged ResourceInclude reaches, merging the control file, as Semi's Controls/_index.axaml does. -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="ControlProbes.axaml" />
  </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>

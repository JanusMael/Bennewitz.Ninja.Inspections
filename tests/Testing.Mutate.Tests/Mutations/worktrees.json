{
  // What plans/00008 adds to the runner it moved from DiffView: the checkout is never edited, a dead run's worktree is
  // removed, a run is held to its budget, a set never edits itself, a repository with no central pins can run, and a
  // swapped project's assembly is what its mutations are judged by. And what plans/00009 adds: the tests run directly
  // where the in-process runner answers and the clean tree is green by it, else through `dotnet test`, and that runner's
  // log is read as its `dotnet test` twin is.
  // Run with this repository's build of the tool, from outside the worktrees it cuts:
  //   dotnet tests/Testing.Mutate.Tests/bin/Release/net10.0/Testing.Mutate.dll --set tests/Testing.Mutate.Tests/Mutations/worktrees.json
  "project": "tests/Testing.Mutate.Tests/Testing.Mutate.Tests.csproj",
  "tests": [
    "tests/Testing.Mutate.Tests/WorktreeRunTests.cs",
    "tests/Testing.Mutate.Tests/OwnSetTests.cs",
    "tests/Testing.Mutate.Tests/InProcessLogTests.cs"
  ],
  "mutations": [
    {
      "name": "the direct way is never chosen",
      "file": "src/Testing.Mutate/Program.cs",
      "old": "string? direct = Dotnet.Property(repo, plan.Project, \"TargetPath\");",
      "new": "string? direct = plan.Project.Length < 0 ? Dotnet.Property(repo, plan.Project, \"TargetPath\") : null;",
      "killer": "A_run_kills_as_declared_from_a_worktree_and_leaves_the_checkout_as_it_found_it",
      "says": "test run: direct"
    },
    {

<Project Sdk="Microsoft.NET.Sdk">
  <!-- Framework packages, IsTestProject and OutputType all come from tests/Directory.Build.props. -->
  <ItemGroup>
    <ProjectReference Include="../../src/XamlQuality/XamlQuality.csproj" />
    <!-- Referenced so ThemeAudit.dll lands in the test output, where AssemblyQualityTests scans it
         beside the library. -->
    <ProjectReference Include="../../src/XamlQuality.ThemeAudit/XamlQuality.ThemeAudit.csproj" />
    <!-- Referenced without its output, which is no shipped assembly, so that building the tests
         restores and builds the source-only package's project: SourceOnlyPackageTests packs it
         without a build, and a pack without a build restores nothing. -->
    <ProjectReference Include="../../src/XamlQuality.ThemeRuntime/XamlQuality.ThemeRuntime.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bennewitz.Ninja.AssemblyQuality" />
  </ItemGroup>
</Project>

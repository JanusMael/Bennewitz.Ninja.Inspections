<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Versioning">
    <PackageVersion Include="Bennewitz.Ninja.AutoVersioning" Version="2026.3.916" />
  </ItemGroup>

  <ItemGroup Label="Tool">
    <!-- The CLI face only. ⛔ The rules LIBRARY takes no package reference at all, and that is a
         contract rather than an accident: a quality analyser that drags dependencies into a
         consumer's test project is one people stop referencing. -->
    <PackageVersion Include="System.CommandLine" Version="2.0.0-beta7.25380.108" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- ⚠ xunit.v3 rather than MSTest, and that is a porting decision rather than a preference.
         The ThemeAudit rules and their fourteen test files came from a repository that uses
         xunit; matching it let those tests move VERBATIM. Converting them instead would have
         meant rewriting the one thing that proves the ported analysis still behaves — which is
         the worst possible file to rewrite during a move.
         ⓘ The rules library itself references no test framework at all, so this choice binds
         nobody: a consumer asserts on findings with whatever runner they already use.
         ⛔ Held on the 3.x line, which Avalonia.Headless.XUnit 12.1.3 is built against
         (xunit.v3.extensibility.core 3.2.2): on 4.0 its discoverer does not hook in, and every
         [AvaloniaFact] in tests/XamlQuality.ThemeRuntime.Tests would run as a plain test with no
         Application, as a family repository found on 12.1.2. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!-- Same Microsoft.Testing.Platform line as xunit.v3 3.2.2 (1.9.1); a newer TrxReport pins
         the platform above what xunit's bundled MSBuild extension can load. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="1.9.1" />
    <!-- No Bennewitz.Ninja.AssemblyQuality: XamlQuality's tests reference src/AssemblyQuality as a
         project, so they are gated by its head rather than its last release (plans/00009 decision
         18), and one restore never holds a project and a package of the same id. -->
  </ItemGroup>

  <PropertyGroup Label="Roslyn">
    <!-- CodeQuality's analyzer and its tests. ⚠ The oldest compiler a consumer can use: an analyzer
         compiled against Roslyn X loads in every compiler X or later and in none before it. 4.14.0
         matches Bennewitz.Ninja.AutoVersioning, the family's other analyzer, by the maintainer's
         choice on 2026-09-25, and it is also the oldest the rules can use: BNCQ1002 reads a C# 14
         extension block's receiver through ITypeSymbol.IsExtension and ExtensionParameter, which
         first appear in 4.14. Measured: 4.13 cannot compile them (CS1061). It moves up only for an
         API the rules cannot do without. The tests resolve the same version through
         Microsoft.CodeAnalysis.CSharp.Workspaces, so the rules are proved on the oldest compiler the
         package claims to support; the suite also passes against 5.9. -->
    <RoslynVersion>4.14.0</RoslynVersion>
  </PropertyGroup>

  <ItemGroup Label="Roslyn">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynVersion)" />
    <!-- ⛔ The testing package floors this at 1.0.1 and raises it for nobody; without this pin the
         tests restore a 2015 Workspaces (NU1701) and run the analyzer on nothing like a consumer's
         compiler. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(RoslynVersion)" />
    <!-- The rules for analyzer authors (RS****). Build-time only; the newest is fine. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <!-- ⛔ Pinned through transitive pinning, for CodeQuality's tests alone: Analyzer.Testing 1.1.4
         reaches it through NuGet.Packaging 7.0.3 at 9.0.6, which GHSA-2fmv-rv2c-59x7 (moderate) and
         GHSA-846f-f764-76mx (high), both published 2026-10-13, make a restore error here. Both are
         patched in 10.0.13. Remove the pin when Analyzer.Testing brings a patched one itself. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Verification">
    <!-- The headless probe under tools/probe, which measures what Avalonia does under its Fluent,
         Simple and Semi themes, and tests/XamlQuality.ThemeRuntime.Tests, which compiles the runtime
         theme check's source files and runs them headless, by plans/00003. ⛔ The rules LIBRARY takes
         none of these, as the Tool group says: it reads markup as text, and nothing under tools/
         ships. No other project in Inspections.slnx may take one, which AvaloniaConfinementTests
         holds. 12.1.3 is the Avalonia the rules' framework claims were measured on. -->
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Markup.Xaml.Loader" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Simple" Version="12.1.3" />
    <PackageVersion Include="Semi.Avalonia" Version="12.1.0.1" />
  </ItemGroup>
</Project>
